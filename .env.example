# Configurazione generata automaticamente da install.sh.
# Se preferisci configurare a mano, copia questo file in ".env" e
# compila i valori sotto.

# Cartella dedicata (host) dove vengono salvate le configurazioni dei
# desktop (una per desktop, nome = proprietario-nome). Deve essere una
# cartella dedicata, non la tua home directory intera: il manager monta
# esattamente questo path dentro il proprio container, quindi vede solo
# quello che c'e' qui dentro.
DATA_DIR=/home/tuo-utente/deskhub-data

# Credenziali dell'amministratore iniziale della webapp (login gestito
# dall'app stessa, non piu' da Traefik). Usate SOLO al primissimo avvio, se
# non esiste ancora nessun utente: una volta creato il primo admin, puoi
# gestire altri utenti dalla webapp (pulsante "Utenti") e queste due righe
# possono restare qui senza effetto, o essere rimosse.
#
# Docker Compose interpola i "$" nei file .env: se la password ne contiene
# uno, raddoppialo ("$$") altrimenti Compose lo sostituisce con una stringa
# vuota. install.sh fa questo automaticamente.
MANAGER_INITIAL_ADMIN_USER=admin
MANAGER_INITIAL_ADMIN_PASSWORD=cambiami

# Segreto condiviso tra manager e Traefik: protegge l'endpoint interno che
# genera il routing dinamico verso i desktop (/session/<token>/). Generato
# automaticamente da install.sh (openssl rand -hex 32) — se configuri a
# mano, un valore casuale qualsiasi va bene, l'importante e' che sia lo
# stesso passato a deploy/traefik/compose.yml.
TRAEFIK_INTERNAL_SECRET=cambiami-con-un-valore-casuale
